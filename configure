NINJA_FILE=build.ninja

printf "" > $NINJA_FILE

echo "rule dafny" >> $NINJA_FILE
echo "  depfile = \$in.d" >> $NINJA_FILE
echo "  command = ./dafnyBuildMD.sh \$in" >> $NINJA_FILE
echo >> $NINJA_FILE

for f in "${files[@]}"; do
    echo build $(dirname $f)/$(basename $f ".dfy").dll: dafny $f >> $NINJA_FILE
done

echo >> $NINJA_FILE

printf "build all: phony" >> $NINJA_FILE
for f in "${files[@]}"; do
    printf " " >> $NINJA_FILE
    printf $(dirname $f)/$(basename $f ".dfy").dll >> $NINJA_FILE
done
echo >> $NINJA_FILE

echo >> $NINJA_FILE

echo "default all" >> $NINJA_FILE
